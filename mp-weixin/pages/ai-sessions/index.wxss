.ai-sessions-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #FFF8F0;
}

.session-list {
  flex: 1;
  padding: 24rpx;
  padding-top: 180rpx;
}

.session-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx 0 rgba(255,107,53,0.06);
}

.session-info {
  margin-bottom: 12rpx;
}

.session-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #2D2D2D;
  font-family: PingFangSC, sans-serif;
}

.session-last-msg {
  font-size: 26rpx;
  color: #8C8C8C;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: PingFangSC, sans-serif;
}

.session-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #BFBFBF;
  font-family: PingFangSC, sans-serif;
}

.new-session-btn {
  background: linear-gradient(135deg, #FF6B35, #FFB347);
  margin: 24rpx;
  border-radius: 48rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.new-session-text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  font-family: PingFangSC, sans-serif;
}
