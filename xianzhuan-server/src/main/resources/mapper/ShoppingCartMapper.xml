<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.xianzhuan.mapper.ShoppingCartMapper">
    <update id="subShopping">
        update shopping_cart
        <set>
            number=#{number}
        </set>
        where
        <if test="itemId != null">
            item_id=#{itemId}
        </if>
    </update>

    <select id="list" parameterType="ShoppingCart" resultType="com.xianzhuan.entity.ShoppingCart">
        select * from shopping_cart
        <where>
            <if test="userId != null">
                and user_id=#{userId}
            </if>
            <if test="itemId != null">
                and item_id=#{itemId}
            </if>
            <if test="itemSpec != null">
                and item_spec = #{itemSpec}
            </if>
        </where>
        order by create_time desc
    </select>
    <insert id="insertBatch" parameterType="list">
        insert into shopping_cart
        (name, image, user_id, item_id, item_spec, number, amount, create_time)
        values
        <foreach collection="shoppingCartList" item="sc" separator=",">
            (#{sc.name},#{sc.image},#{sc.userId},#{sc.itemId},#{sc.itemSpec},#{sc.number},#{sc.amount},#{sc.createTime})
        </foreach>
    </insert>
</mapper>
