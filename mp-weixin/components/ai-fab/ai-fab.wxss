.ai-fab {
  position: fixed;
  right: 30rpx;
  bottom: 160rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #FFB347);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx 0 rgba(255, 107, 53, 0.4);
  z-index: 100;
  animation: fab-pulse 2s infinite;
}

.fab-icon {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.fab-text {
  font-size: 18rpx;
  color: #FFFFFF;
  margin-top: 2rpx;
  line-height: 1;
}

@keyframes fab-pulse {
  0% { box-shadow: 0 6rpx 20rpx 0 rgba(255, 107, 53, 0.4); }
  50% { box-shadow: 0 6rpx 30rpx 0 rgba(255, 107, 53, 0.6); }
  100% { box-shadow: 0 6rpx 20rpx 0 rgba(255, 107, 53, 0.4); }
}
