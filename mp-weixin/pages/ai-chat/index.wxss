.ai-chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #FFF8F0;
}

.message-list {
  flex: 1;
  padding: 24rpx 0;
  padding-top: 160rpx;
  overflow-y: auto;
}

.welcome-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.welcome-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 12rpx;
  font-family: PingFangSC, sans-serif;
}

.welcome-desc {
  font-size: 26rpx;
  color: #8C8C8C;
  margin-bottom: 48rpx;
  font-family: PingFangSC, sans-serif;
}

.quick-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
}

.quick-btn {
  background: #FFFFFF;
  border: 1rpx solid #F0E6D8;
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: #FF6B35;
  font-family: PingFangSC, sans-serif;
  box-shadow: 0 2rpx 8rpx 0 rgba(255,107,53,0.06);
}

.typing-indicator {
  padding: 12rpx 48rpx;
  font-size: 24rpx;
  color: #8C8C8C;
  font-family: PingFangSC, sans-serif;
}

.typing-dots {
  animation: pulse 1.2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0E6D8;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #FFF8F0;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-family: PingFangSC, sans-serif;
  color: #2D2D2D;
  border: 1rpx solid #F0E6D8;
}

.send-btn {
  margin-left: 16rpx;
  width: 120rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #D9D9D9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn-active {
  background: #FF6B35;
}

.send-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  font-family: PingFangSC, sans-serif;
}
