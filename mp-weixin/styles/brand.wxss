@charset "UTF-8";

page {
  --brand-primary: #FF6B35;
  --brand-secondary: #FFB347;
  --brand-background: #FFF8F0;
  --brand-text-primary: #2D2D2D;
  --brand-text-secondary: #8C8C8C;
  --brand-accent: #FF4D4F;
  --brand-border: #F0E6D8;
  --brand-card: #FFFFFF;
  --brand-success: #52C41A;
  --brand-font-family: PingFangSC, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.font-title-lg {
  font-size: 40rpx;
  font-weight: 600;
  font-family: var(--brand-font-family);
}

.font-title {
  font-size: 36rpx;
  font-weight: 500;
  font-family: var(--brand-font-family);
}

.font-body {
  font-size: 28rpx;
  font-weight: 400;
  font-family: var(--brand-font-family);
}

.font-caption {
  font-size: 24rpx;
  font-weight: 400;
  font-family: var(--brand-font-family);
}

.font-tag {
  font-size: 22rpx;
  font-weight: 400;
  font-family: var(--brand-font-family);
}

.brand-btn-primary {
  background: var(--brand-primary);
  color: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  font-family: var(--brand-font-family);
  border: none;
  text-align: center;
}

.brand-btn-gradient {
  background: linear-gradient(135deg, #FF6B35, #FFB347);
  color: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  font-family: var(--brand-font-family);
  border: none;
  text-align: center;
}

.brand-card {
  background: var(--brand-card);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(255,107,53,0.08);
  padding: 24rpx;
}

.brand-input {
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid var(--brand-border);
  font-size: 28rpx;
  font-family: var(--brand-font-family);
}
