# ==============================================================================
# 闲转平台 (xianzhuan-platform) 环境变量与外部配置模版 (.env.example)
# ==============================================================================

# 服务端口与运行环境
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# MySQL 关系型数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xianzhuan_platform
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Redis 缓存与分布式锁配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=10

# Apache RocketMQ 消息队列配置
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
ROCKETMQ_PRODUCER_GROUP=xianzhuan-producer-group
ROCKETMQ_CONSUMER_GROUP=xianzhuan-consumer-group

# 阿里云通义千问 (DashScope) AI估价配置
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
AI_COLLECTION_NAME=pricing_knowledge

# 微信支付与小程序凭证
WECHAT_APPID=wx9af46f654f78c66d
WECHAT_SECRET=your_wechat_app_secret
WECHAT_MCH_ID=your_merchant_id
WECHAT_MCH_SERIAL_NO=your_merchant_serial_no
WECHAT_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
WECHAT_API_V3_KEY=your_api_v3_key

# 腾讯云 COS 对象存储配置
TENCENT_COS_SECRET_ID=your_cos_secret_id
TENCENT_COS_SECRET_KEY=your_cos_secret_key
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET_NAME=xianzhuan-1383957992
TENCENT_COS_AVATAR_DIR=xianzhuan-platform/avatar/
TENCENT_COS_IMAGE_DIR=xianzhuan-platform/item/

# JWT 双Token鉴权安全密钥
JWT_ADMIN_SECRET_KEY=xianzhuan_admin_jwt_secret_key_2025
JWT_ADMIN_TTL_MS=7200000
JWT_ADMIN_TOKEN_NAME=token

JWT_USER_SECRET_KEY=xianzhuan_user_jwt_secret_key_2025
JWT_USER_TTL_MS=7200000
JWT_USER_TOKEN_NAME=authentication

JWT_REFRESH_SECRET_KEY=xianzhuan_refresh_jwt_secret_key_2025
JWT_REFRESH_TTL_MS=604800000
